  BOOKING
  PAYMENT
  WORKER
  MANAGER
  ADMIN
  OFFICE
  AREA
  SERVICE
  ATTENDANCE
  CRM
  SUPPORT
  PROFILE
  BANNER
  SETTINGS
  USER
}

model ActivityLog {
  id             String         @id @default(uuid())
  action         ActivityAction
  module         ActivityModule
  description    String
  actorId        String?
  actorName      String
  actorRole      Role
  targetId       String?
  targetType     String?
  organizationId String?
  metadata       Json?
  ipAddress      String?
  device         String?
  platform       String?
  createdAt      DateTime       @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([organizationId])
  @@index([module])
  @@index([action])
  @@index([actorRole])
}

// ─── Webhook Models ───────────────────────────────────────────────────────────

enum WebhookProvider {
  RAZORPAY
}

enum WebhookStatus {
  PENDING
  PROCESSED
  FAILED
  SKIPPED
}

model WebhookEvent {
  id          String          @id @default(uuid())
  provider    WebhookProvider
  event       String
  externalId  String?
  payload     Json
  status      WebhookStatus   @default(PENDING)
  error       String?
  processedAt DateTime?
  retries     Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([provider, event, externalId])
  @@index([provider, status])
  @@index([event])
  @@index([status])
  @@index([createdAt])
}

// ─── Banners ──────────────────────────────────────────────────────────────────

enum BannerRedirectType {
  NONE
  SERVICE
  CATEGORY
  EXTERNAL_URL
}

model Banner {
  id            String             @id @default(uuid())
  title         String
  subtitle      String?
  imageUrl      String
  redirectType  BannerRedirectType @default(NONE)
  redirectValue String?
  // Website-only (Module 3) — nullable/additive, not selected by the Mobile App's
  // BannersService.findActive() response shape beyond an extra harmless field.
  buttonText    String?
  displayOrder  Int                @unique
  isActive      Boolean            @default(true)
  deletedAt     DateTime?
  createdBy     String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([isActive])
  @@index([displayOrder])
  @@index([deletedAt])
}

// ─── Attendance Rules (singleton) ─────────────────────────────────────────────

model AttendanceRule {
  id                             String   @id @default("singleton")
  officeRadius                   Int      @default(200)
  lateAfter                      String   @default("09:30")
  halfDayAfter                   String   @default("13:00")
  checkOutBefore                 String   @default("17:00")
  minimumWorkingHours            Int      @default(8)
  autoAbsentTime                 String   @default("15:00")
  allowOutsideOffice             Boolean  @default(false)
  requireSelfie                  Boolean  @default(true)
  requireLiveLocation            Boolean  @default(true)
  allowMultipleCheckIn           Boolean  @default(false)
  enableAttendance               Boolean  @default(true)
  weekends                       String[]
  requireAdminAttendanceApproval Boolean  @default(false)
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt
}

