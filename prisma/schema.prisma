  SERVICE_UPDATED
  PRICE_UPDATED
  ATTENDANCE_UPDATED
  COMPLAINT_CREATED
  COMPLAINT_RESOLVED
  SUPPORT_TICKET_CREATED
  SUPPORT_TICKET_UPDATED
  SUPPORT_TICKET_CLOSED
  PROFILE_UPDATED
