# Application
NODE_ENV=development
PORT=3000

# Public base URL — used in all generated URLs (uploads, exports, downloads).
# Must be reachable by the client (mobile app, browser).
# Use your LAN IP for local development; your domain in production.
BASE_URL=http://192.168.x.x:3000

# Database
DATABASE_URL="postgresql://postgres:Sahil%40123@localhost:5432/eservices"

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# CORS (comma-separated origins, or * for all)
CORS_ORIGIN=*

# Firebase Admin SDK — required for mobile phone authentication (POST /auth/mobile-login)
# and push notifications. Provide one of the three options below.
#
# Option 1 — inline JSON string (recommended for CI/containers/K8s secrets):
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project",...}
#
# Option 2 — path to key file (relative to project root):
# FIREBASE_SERVICE_ACCOUNT_PATH=firebase/service-account.json
#
# Option 3 — place key file at firebase/service-account.json (auto-detected, no env var needed)
FIREBASE_SERVICE_ACCOUNT_PATH=firebase/service-account.json

# MSG91 SMS — omit to use console logging (dev mode)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# SMTP (Brevo / SendGrid / Gmail / any STARTTLS provider)
# All four are required for email sending (forgot-password, OTP email)
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USER=your-smtp-username@example.com
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=no-reply@ziclo.in
